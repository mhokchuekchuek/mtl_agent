# LLM API Keys
OPENAI_API_KEY=

# Qdrant Configuration
# Use 'qdrant' for Docker, 'localhost' for local development
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Redis Configuration (for LiteLLM caching)
# Use 'redis' for Docker, 'localhost' for local development
REDIS_HOST=localhost
REDIS_PORT=6379

# LiteLLM Proxy Configuration
# Use 'http://litellm:4000' for Docker, 'http://localhost:4000' for local development
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-1234
LITELLM_SALT_KEY=sk-your-salt-key-here

# ERP Database (SQLite)
ERP_DATABASE_PATH=data/erp_database.db

# PostgreSQL - LiteLLM Database
# Use 'postgres' for Docker, 'localhost' for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/litellm

# PostgreSQL - ERP Agent (for long-term memory store)
# Use 'postgres' for Docker, 'localhost' for local development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

